{
  "expo": {
    "name": "PalanteMX",
    "slug": "PalanteMX",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "palantemx",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PalanteMX usa tu ubicación para comprobar que estás en la obra al llenar la bitácora y para mostrarte trabajos cerca de ti."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PalanteMX usa tus fotos para tu perfil, tus vacantes y la evidencia de tus obras.",
          "cameraPermission": "PalanteMX usa la cámara para tomar la foto de evidencia de tu avance en la obra."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
